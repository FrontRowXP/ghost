{{#> emailWrapper}}
              <tr>
                <td class="wrapper">
                  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr class="post-content-row">
                      <td class="{{classes.content}}">
                        {{{content}}}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td class="wrapper" align="center">
                  <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="padding-top: 40px; padding-bottom: 30px;">
                    {{#if footerContent }}
                      <tr>
                        <td class="footer">{{{footerContent}}}</td>
                      </tr>
                    {{/if}}
                    <tr>
                      <td class="footer">
                        {{siteTitle}} &copy; {{year}} &mdash; {{#if unsubscribeUrl}}<a href="{{unsubscribeUrl}}">{{t "Unsubscribe"}}</a>{{else}}<a href="{{managePreferencesUrl}}">{{t "Manage your preferences"}}</a>{{/if}}
                      </td>
                    </tr>
                    {{#if showBadge }}
                      <tr>
                        <td class="footer-powered"><a href="https://frontro.com" style="color: inherit; text-decoration: none;"><img src="https://gather.frontro.com/public/frontro/icon.png" border="0" width="24" height="24" alt="Frontro" style="vertical-align: middle;"> Powered by Frontro</a></td>
                      </tr>
                    {{/if}}
                  </table>
                </td>
              </tr>
{{/emailWrapper}}
